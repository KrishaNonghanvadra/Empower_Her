<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User_Master_Page.master.cs" Inherits="Empower_Her_1.User_HTML.User_Master_Page" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport" 
          content="width=device-width, initial-scale=1" />

    <title>EmpowerHer</title>

    <!-- Master Page CSS -->
    <link href="../CSS/User_Master_page.css" rel="stylesheet" />

    <!-- Page-specific CSS -->
    <asp:ContentPlaceHolder 
        ID="head" 
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form id="form1" runat="server">


    <!-- ================= HEADER ================= -->

    <header class="user-header">

        <!-- Logo -->
        <div class="header-logo">

            <h2>EmpowerHer</h2>

        </div>


        <!-- Navigation -->
        <nav class="header-nav">

            <a href="User_home_page.aspx">
                Home
            </a>

            <a href="#">
                About
            </a>

            <a href="#">
                Features
            </a>

            <a href="#">
                Schemes
            </a>

        </nav>


        <!-- Right Side -->
        <div class="header-right">

            <!-- Notification -->
            <a href="#" class="notification">

                🔔

                <span class="notification-badge">
                    3
                </span>

            </a>


            <!-- Profile -->
            <div class="profile">

                <div class="profile-img">
                    U
                </div>

                <span class="profile-name">
                    User
                </span>

            </div>

        </div>

    </header>


    <!-- ================= PAGE CONTENT ================= -->

    <main class="main-content">

        <asp:ContentPlaceHolder 
            ID="ContentPlaceHolder1" 
            runat="server">

        </asp:ContentPlaceHolder>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="user-footer">

        <div class="footer-content">

            <h3>EmpowerHer</h3>

            <p>
                Empowering Women Through Skills & Opportunities
            </p>

            <p class="copyright">
                © 2026 EmpowerHer. All Rights Reserved.
            </p>

        </div>

    </footer>


</form>

</body>

</html>
