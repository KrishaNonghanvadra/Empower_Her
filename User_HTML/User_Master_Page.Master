<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User_Master_Page.master.cs" Inherits="Empower_Her_1.User_HTML.User_Master_Page" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport" 
          content="width=device-width, initial-scale=1" />

    <title>EmpowerHer</title>


    <link href="<%= ResolveUrl("~/User_CSS/User_Master_Page1.css") %>"
         rel="stylesheet" />

    <!-- Page-specific CSS -->
    <asp:ContentPlaceHolder 
        ID="head" 
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form id="form1" runat="server">
    
    <!-- =========================================
         HEADER
    ========================================== -->

    <header class="user-header">


        <!-- LOGO -->

        <div class="header-logo">

            <div class="logo-icon">
                ♡
            </div>

            <span class="logo-text">EmpowerHer
            </span>

        </div>


        <!-- HEADER RIGHT -->

        <div class="header-right">

            <!-- Notification -->

            <a href="User_Notifications.aspx" class="notification">

                🔔

                <span class="notification-badge">
                    3
                </span>

            </a>


            <!-- Profile -->

            <div class="profile">

                <div class="profile-img">
                    K
                </div>

                <span class="profile-name">
                    krisha Patel
                </span>

            </div>

        </div>

    </header>



    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside class="sidebar">


        <!-- Dashboard -->

        <a href="User_home_page.aspx"
           class="sidebar-link active">

            <span class="sidebar-icon">
                🏠
            </span>

            <span>
                Dashboard
            </span>

        </a>


        <!-- Products -->

        <a href="User_My_Products.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                ▣
            </span>

            <span>
                Products
            </span>

        </a>


        <!-- Government Schemes -->

        <a href="User_Government_Schemes.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                🏛
            </span>

            <span>
                Government Schemes
            </span>

        </a>


        <!-- Financial Literacy -->

        <a href="User_Financial_Literacy.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                ▣
            </span>

            <span>
                Financial Literacy
            </span>

        </a>


        <!-- Notifications -->

        <a href="User_Notifications.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                ⏱
            </span>

            <span>
                Notifications
            </span>

        </a>


        <!-- My Profile -->

        <a href="User_My_Profile.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                ◉
            </span>

            <span>
                My Profile
            </span>

        </a>


        <!-- Settings -->

        <a href="User_Change_Password.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                ⚙
            </span>

            <span>
                Settings
            </span>

        </a>


        <!-- Courses -->

        <a href="User_Courses.aspx"
           class="sidebar-link">

            <span class="sidebar-icon">
                ▣
            </span>

            <span>
                Courses
            </span>

        </a>


        <!-- Logout -->

        <a href="User_home_page.aspx"
           class="sidebar-link logout-link">

            <span class="sidebar-icon">
                ⇥
            </span>

            <span>
                Logout
            </span>

        </a>


    </aside>



    <!-- =========================================
         MAIN CONTENT
    ========================================== -->

    <main class="main-content">


        <asp:ContentPlaceHolder
            ID="ContentPlaceHolder1"
            runat="server">

        </asp:ContentPlaceHolder>


    </main>



    <!-- =========================================
         FOOTER
    ========================================== -->

    <footer class="user-footer">

        <div class="footer-content">

            <div>

                <h3>
                    EmpowerHer
                </h3>

                <p>
                    Empowering Women Through Skills & Opportunities
                </p>

            </div>


            <div>

                <p class="copyright">
                    © 2026 EmpowerHer. All Rights Reserved.
                </p>

            </div>

        </div>

    </footer>


</form>



</body>

</html>
